@file src/app/api/search/route.ts modified +13 -2 newsha=7b3d5f8
@@ -1,9 +1,14 @@
 import { NextResponse } from "next/server";
 import { search } from "@/lib/search";
+import { take } from "@/lib/rate-limit";
 
 export async function GET(request: Request) {
   const url = new URL(request.url);
   const query = url.searchParams.get("q") ?? "";
-  const results = await search(query);
-  return NextResponse.json({ results });
+  const apiKey = request.headers.get("x-api-key");
+  if (apiKey) {
+    const decision = await take(apiKey);
+    if (!decision.allowed) return tooMany(decision.resetSeconds);
+  }
+  return NextResponse.json({ results: await search(query) });
 }
@@ -10,2 +15,9 @@
 
 export const runtime = "nodejs";
+
+function tooMany(resetSeconds: number) {
+  return NextResponse.json(
+    { error: "rate_limited", retryAfter: resetSeconds },
+    { status: 429, headers: { "retry-after": String(resetSeconds) } },
+  );
+}

@note +8..11 kind=security risk=high confidence=0.8
why: Requests without an `x-api-key` header are not limited at all. Anonymous
  search traffic goes through the CDN and was already capped there, and adding
  an IP-based limit here would have hit shared-NAT users.

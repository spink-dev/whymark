{
  "name": "whymark",
  "version": "0.3.0",
  "description": "whymark \u2014 a file format and reviewer for reading AI-written code changes with the reasoning, sources, and verification attached to each line.",
  "author": "Samuel Spink",
  "license": "MIT",
  "bin": {
    "whymark": "./bin/whymark.mjs"
  },
  "files": [
    "bin",
    "dist/whymark.mjs",
    "prompts/whymark-author.md",
    "spec/whymark-v1.md",
    "README.md",
    "LICENSE",
    ".agents/skills/whymark/SKILL.md",
    "dist/whymark-vscode.vsix",
    "dist/vscode-extension.json"
  ],
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spink-dev/whymark.git"
  },
  "homepage": "https://whymark.x47.dev",
  "bugs": {
    "url": "https://github.com/spink-dev/whymark/issues"
  },
  "keywords": [
    "whymark",
    "code-review",
    "diff",
    "cli",
    "annotations"
  ],
  "scripts": {
    "dev": "next dev --port 43917",
    "build": "next build",
    "build:cli": "esbuild src/cli/whymark.ts --bundle --platform=node --format=esm --outfile=dist/whymark.mjs --external:yaml --legal-comments=none --banner:js='/* generated by npm run build:cli \u2014 do not edit */'",
    "prepublishOnly": "npm run build:cli",
    "start": "next start --port 43917",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:cli && npm run package:vscode && vitest run",
    "test:watch": "vitest",
    "test:ui": "node tests/e2e/viewer.mjs",
    "whymark": "tsx src/cli/whymark.ts",
    "prepack": "npm run build:cli && npm run package:vscode",
    "build:vscode": "node extensions/vscode/scripts/build.mjs",
    "package:vscode": "node extensions/vscode/scripts/package.mjs",
    "test:vscode": "npm run build:vscode && node extensions/vscode/scripts/test.mjs",
    "test:vscode:ui": "npm run build:vscode && node tests/e2e/vscode.mjs",
    "publish:vscode": "vsce publish --packagePath .artifacts/whymark-vscode.vsix"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.96.0",
    "@vercel/analytics": "^2.0.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "lucide-react": "^0.545.0",
    "next": "16.3.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "shiki": "^3.13.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
